<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Department Tree View -->
    <record id="view_fps_department_tree" model="ir.ui.view">
        <field name="name">fps.product.department.tree</field>
        <field name="model">fps.product.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="is_fresh"/>
                <field name="is_weighted"/>
                <field name="default_snap_eligible"/>
                <field name="product_count"/>
            </tree>
        </field>
    </record>

    <!-- Department Form View -->
    <record id="view_fps_department_form" model="ir.ui.view">
        <field name="name">fps.product.department.form</field>
        <field name="model">fps.product.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_fresh"/>
                            <field name="is_weighted"/>
                            <field name="default_snap_eligible"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Department Action -->
    <record id="action_fps_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">fps.product.department</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_fps_grocery_root" name="Grocery" sequence="25"/>
    <menuitem id="menu_fps_departments" name="Departments" parent="menu_fps_grocery_root" action="action_fps_department" sequence="10"/>

    <!-- Product Template Extension -->
    <record id="view_product_template_form_grocery" model="ir.ui.view">
        <field name="name">product.template.form.grocery</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Grocery" name="grocery">
                    <group>
                        <group string="Department">
                            <field name="fps_department_id"/>
                            <field name="snap_eligible"/>
                        </group>
                        <group string="Weight/Scale">
                            <field name="is_weighted"/>
                            <field name="plu_code"/>
                            <field name="scale_label_format"/>
                        </group>
                    </group>
                    <group>
                        <group string="Freshness">
                            <field name="is_perishable"/>
                            <field name="shelf_life_days"/>
                            <field name="requires_refrigeration"/>
                            <field name="is_fresh_prep"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
