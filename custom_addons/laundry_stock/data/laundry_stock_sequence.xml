<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_laundry_stock_issue" model="ir.sequence">
            <field name="name">Laundry Material Issue</field>
            <field name="code">laundry.stock.issue</field>
            <field name="prefix">MI/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_laundry_purchase_request" model="ir.sequence">
            <field name="name">Laundry Purchase Request</field>
            <field name="code">laundry.purchase.request</field>
            <field name="prefix">PR/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Where consumed materials go: what lands here the laundry used up. -->
        <record id="stock_location_laundry_consumption" model="stock.location">
            <field name="name">Laundry Consumption / استهلاك المغسلة</field>
            <field name="location_id" ref="stock.stock_location_locations_virtual"/>
            <field name="usage">view</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
