<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_laundry_purchase_request_list" model="ir.ui.view">
        <field name="name">laundry.purchase.request.list</field>
        <field name="model">laundry.purchase.request</field>
        <field name="arch" type="xml">
            <tree string="Purchase Requests"
                  decoration-muted="state in ('cancel', 'rejected')"
                  decoration-bf="priority == '1'">
                <field name="name"/>
                <field name="date_request"/>
                <field name="branch_id"/>
                <field name="user_id"/>
                <field name="date_required" optional="show"/>
                <field name="priority" optional="hide"/>
                <field name="estimated_total" sum="Estimated Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-success="state in ('approved', 'purchased')"
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_laundry_purchase_request_form" model="ir.ui.view">
        <field name="name">laundry.purchase.request.form</field>
        <field name="model">laundry.purchase.request</field>
        <field name="arch" type="xml">
            <form string="Purchase Request">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit for Approval" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="state != 'to_approve'"
                            groups="laundry_stock.group_laundry_purchaser,laundry_base.group_laundry_manager"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            invisible="state != 'to_approve'"
                            groups="laundry_stock.group_laundry_purchaser,laundry_base.group_laundry_manager"/>
                    <button name="action_create_rfq" type="object"
                            string="Create RFQ" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('cancel', 'purchased')"/>
                    <button name="action_draft" type="object"
                            string="Back to Draft"
                            invisible="state in ('draft', 'purchased')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,to_approve,approved,purchased"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_count == 0">
                            <field name="purchase_count" widget="statinfo"
                                   string="Purchase Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request">
                            <field name="branch_id"
                                   readonly="state not in ('draft', 'to_approve')"
                                   options="{'no_create': True}"/>
                            <field name="user_id"
                                   readonly="state not in ('draft', 'to_approve')"/>
                            <field name="date_request"
                                   readonly="state not in ('draft', 'to_approve')"/>
                            <field name="date_required"
                                   readonly="state not in ('draft', 'to_approve')"/>
                            <field name="priority" widget="priority"
                                   readonly="state not in ('draft', 'to_approve')"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Approval">
                            <field name="approver_id"
                                   invisible="state in ('draft', 'to_approve')"/>
                            <field name="approval_date"
                                   invisible="state in ('draft', 'to_approve')"/>
                            <field name="reason"
                                   placeholder="Why it was rejected"
                                   invisible="state == 'draft'"
                                   readonly="state not in ('to_approve', 'rejected')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids"
                                   readonly="state not in ('draft', 'to_approve')">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="description" optional="hide"/>
                                    <field name="qty_available" readonly="1"
                                           optional="show"/>
                                    <field name="product_qty"/>
                                    <field name="product_uom_category_id"
                                           column_invisible="1"/>
                                    <field name="product_uom_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="partner_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Estimated Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="estimated_total" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"
                                   placeholder="Why the branch needs this."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_laundry_purchase_request_search" model="ir.ui.view">
        <field name="name">laundry.purchase.request.search</field>
        <field name="model">laundry.purchase.request</field>
        <field name="arch" type="xml">
            <search string="Purchase Requests">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="user_id"/>
                <filter name="filter_to_approve" string="To Approve"
                        domain="[('state', '=', 'to_approve')]"/>
                <filter name="filter_approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="filter_purchased" string="Purchased"
                        domain="[('state', '=', 'purchased')]"/>
                <separator/>
                <filter name="filter_my" string="My Requests"
                        domain="[('user_id', '=', uid)]"/>
                <filter name="filter_urgent" string="Urgent"
                        domain="[('priority', '=', '1')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Request Date"
                            context="{'group_by': 'date_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_laundry_purchase_request" model="ir.actions.act_window">
        <field name="name">Purchase Requests</field>
        <field name="res_model">laundry.purchase.request</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_laundry_purchase_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask for what the branch needs</p>
            <p>A branch writes what it wants to buy, a manager approves it, and
               it becomes one request for quotation per vendor — delivered to
               the branch that asked for it.</p>
        </field>
    </record>

    <record id="action_laundry_purchase_request_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">laundry.purchase.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'to_approve')]</field>
        <field name="search_view_id" ref="view_laundry_purchase_request_search"/>
    </record>

</odoo>
