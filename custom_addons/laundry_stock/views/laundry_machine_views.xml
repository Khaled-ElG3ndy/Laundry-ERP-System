<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_laundry_machine_list" model="ir.ui.view">
        <field name="name">laundry.machine.list</field>
        <field name="model">laundry.machine</field>
        <field name="arch" type="xml">
            <tree string="Machines">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="machine_type"/>
                <field name="branch_id"/>
                <field name="capacity_kg" optional="show"/>
                <field name="serial_number" optional="hide"/>
                <field name="install_date" optional="hide"/>
                <field name="warranty_end" optional="show"/>
                <field name="maintenance_cost" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_laundry_machine_form" model="ir.ui.view">
        <field name="name">laundry.machine.form</field>
        <field name="model">laundry.machine</field>
        <field name="arch" type="xml">
            <form string="Machine">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_issues" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="issue_count" widget="statinfo"
                                   string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Washer 1"/></h1>
                    </div>
                    <group>
                        <group string="Machine">
                            <field name="code"/>
                            <field name="machine_type"/>
                            <field name="branch_id"/>
                            <field name="capacity_kg"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Purchase &amp; Warranty">
                            <field name="serial_number"/>
                            <field name="vendor_id"/>
                            <field name="install_date"/>
                            <field name="warranty_end"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="maintenance_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Service history, settings, anything worth keeping."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_laundry_machine_search" model="ir.ui.view">
        <field name="name">laundry.machine.search</field>
        <field name="model">laundry.machine</field>
        <field name="arch" type="xml">
            <search string="Machines">
                <field name="name"/>
                <field name="code"/>
                <field name="serial_number"/>
                <field name="branch_id"/>
                <filter name="filter_warranty" string="Under Warranty"
                        domain="[('warranty_end', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_branch" string="Branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter name="group_by_type" string="Type"
                            context="{'group_by': 'machine_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_laundry_machine" model="ir.actions.act_window">
        <field name="name">Machines</field>
        <field name="res_model">laundry.machine</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register a machine</p>
            <p>Washers, dryers, ironers and boilers. Spare parts issued for
               maintenance are charged to the machine they went into.</p>
        </field>
    </record>

</odoo>
