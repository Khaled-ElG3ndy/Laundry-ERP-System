<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- What is actually on the shelves, branch by branch. -->
    <record id="action_laundry_stock_quant" model="ir.actions.act_window">
        <field name="name">Stock on Hand</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree,pivot</field>
        <field name="view_id" ref="stock.view_stock_quant_tree"/>
        <field name="search_view_id" ref="stock.quant_search_view"/>
        <field name="domain">[('product_id.is_laundry_supply', '=', True)]</field>
        <field name="context">{'search_default_internal_loc': 1,
                               'search_default_locationgroup': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing in the store yet</p>
            <p>Receive a purchase order, or count the store, and the quantities
               show up here.</p>
        </field>
    </record>

    <!-- Counting the store: the same screen, but editable. -->
    <record id="action_laundry_stock_count" model="ir.actions.act_window">
        <field name="name">Count Stock</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="search_view_id" ref="stock.quant_search_view"/>
        <field name="domain">[('product_id.is_laundry_supply', '=', True)]</field>
        <field name="context">{'search_default_internal_loc': 1,
                               'inventory_mode': True}</field>
    </record>

    <record id="action_laundry_stock_reordering" model="ir.actions.act_window">
        <field name="name">Reordering Rules</field>
        <field name="res_model">stock.warehouse.orderpoint</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="search_view_id" ref="stock.warehouse_orderpoint_search"/>
        <field name="domain">[('product_id.is_laundry_supply', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set a reordering rule</p>
            <p>Give a supply a minimum and a maximum per branch store and Odoo
               tells you what to buy before the branch runs out.</p>
        </field>
    </record>

    <record id="action_laundry_stock_receipt" model="ir.actions.act_window">
        <field name="name">Receipts</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="domain">[('picking_type_id.code', '=', 'incoming')]</field>
        <field name="context">{'contact_display': 'partner_address'}</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
    </record>





</odoo>
