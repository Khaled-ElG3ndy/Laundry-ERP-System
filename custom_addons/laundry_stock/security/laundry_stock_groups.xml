<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_laundry_storekeeper" model="res.groups">
            <field name="name">Laundry / Store Keeper</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Receives goods, issues materials to the floor
                and counts the branch store.</field>
        </record>

        <record id="group_laundry_purchaser" model="res.groups">
            <field name="name">Laundry / Purchasing Officer</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[
                (4, ref('purchase.group_purchase_user')),
                (4, ref('group_laundry_storekeeper')),
            ]"/>
            <field name="comment">Approves purchase requests and deals with the
                vendors.</field>
        </record>

    </data>

    <!-- These records adjust groups that other modules own. They stay out of
         the noupdate block above on purpose: a change to who implies what has
         to reach an existing database on upgrade, not only on a fresh install. -->
    <data>

        <!-- A branch manager runs the store of the branch, which in Odoo's
             own Inventory app means the manager rights: the configuration and
             the reporting sections live behind them. -->
        <record id="laundry_base.group_laundry_manager" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('group_laundry_storekeeper')),
                (4, ref('stock.group_stock_manager')),
            ]"/>
        </record>

        <!-- The system admin gets the full inventory and purchasing rights. -->
        <record id="laundry_base.group_laundry_admin" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('group_laundry_purchaser')),
                (4, ref('stock.group_stock_manager')),
                (4, ref('purchase.group_purchase_manager')),
            ]"/>
        </record>

        <!-- Storage zones only exist if multi-location storage is on. -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_multi_locations'))]"/>
        </record>
    </data>
</odoo>
