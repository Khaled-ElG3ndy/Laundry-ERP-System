<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_laundry_pos_normalize" model="ir.ui.view">
        <field name="name">product.template.form.laundry.pos.normalize</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_normalize_laundry_pos_attributes"
                    type="object"
                    string="Normalize Laundry POS"
                    class="btn-primary"
                />
            </xpath>
        </field>
    </record>
</odoo>
