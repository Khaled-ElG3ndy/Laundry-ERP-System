<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Add custom class to Product Screen -->
    <t t-name="pos_foam_modern_ui.ProductScreen"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'product-screen')]" position="attributes">
            <attribute name="class" add=" foam-modern-pos" separator=" "/>
        </xpath>
    </t>

    <!-- Add custom class to Payment Screen -->
    <t t-name="pos_foam_modern_ui.PaymentScreen"
       t-inherit="point_of_sale.PaymentScreen"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'payment-screen')]" position="attributes">
            <attribute name="class" add=" foam-modern-pos-payment" separator=" "/>
        </xpath>
    </t>

</templates>
