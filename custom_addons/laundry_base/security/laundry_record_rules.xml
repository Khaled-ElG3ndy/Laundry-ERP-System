<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cashiers see only their own branch orders -->
        <record id="rule_laundry_order_cashier" model="ir.rule">
            <field name="name">Laundry Order: Cashier sees own branch</field>
            <field name="model_id" ref="model_laundry_order"/>
            <field name="groups" eval="[(4, ref('laundry_base.group_laundry_cashier'))]"/>
            <field name="domain_force">[
                '|',
                ('branch_id.manager_id', '=', user.id),
                ('user_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Supervisors and above see all orders (no restriction) -->
        <record id="rule_laundry_order_supervisor" model="ir.rule">
            <field name="name">Laundry Order: Supervisor sees all</field>
            <field name="model_id" ref="model_laundry_order"/>
            <field name="groups" eval="[(4, ref('laundry_base.group_laundry_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
