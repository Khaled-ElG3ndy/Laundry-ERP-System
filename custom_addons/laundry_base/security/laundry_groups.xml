<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="group_laundry_cashier" model="res.groups">
            <field name="name">Laundry / Cashier</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
        </record>

        <record id="group_laundry_production" model="res.groups">
            <field name="name">Laundry / Production Staff</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
        </record>

        <record id="group_laundry_delivery" model="res.groups">
            <field name="name">Laundry / Delivery Staff</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
        </record>

        <record id="group_laundry_supervisor" model="res.groups">
            <field name="name">Laundry / Supervisor</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[
                (4, ref('group_laundry_cashier')),
                (4, ref('group_laundry_production'))
            ]"/>
        </record>

        <record id="group_laundry_manager" model="res.groups">
            <field name="name">Laundry / Branch Manager</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[
                (4, ref('group_laundry_supervisor')),
                (4, ref('group_laundry_delivery'))
            ]"/>
        </record>

        <record id="group_laundry_finance" model="res.groups">
            <field name="name">Laundry / Finance</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
        </record>

        <record id="group_laundry_admin" model="res.groups">
            <field name="name">Laundry / System Admin</field>
            <field name="category_id" ref="base.module_category_point_of_sale"/>
            <field name="implied_ids" eval="[
                (4, ref('group_laundry_manager')),
                (4, ref('group_laundry_finance'))
            ]"/>
        </record>

    </data>
</odoo>
