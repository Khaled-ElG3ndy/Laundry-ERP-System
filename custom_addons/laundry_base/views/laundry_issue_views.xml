<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_issue_list" model="ir.ui.view">
        <field name="name">laundry.issue.list</field>
        <field name="model">laundry.issue</field>
        <field name="arch" type="xml">
            <tree string="Issues" decoration-danger="state == 'open'"><field name="name"/><field name="order_id"/><field name="partner_id"/><field name="issue_type"/><field name="state" widget="badge" decoration-danger="state == 'open'" decoration-warning="state == 'in_review'" decoration-success="state in ('resolved','closed')"/><field name="reported_by"/><field name="reported_date"/></tree>
        </field>
    </record>
    <record id="view_laundry_issue_form" model="ir.ui.view">
        <field name="name">laundry.issue.form</field>
        <field name="model">laundry.issue</field>
        <field name="arch" type="xml">
            <form><header><button name="action_resolve" string="Mark Resolved" type="object" class="btn-success" invisible="state not in ('open','in_review')"/><field name="state" widget="statusbar" statusbar_visible="open,in_review,resolved,closed"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="order_id"/><field name="order_line_id"/><field name="issue_type"/><field name="reported_by" readonly="1"/><field name="reported_date" readonly="1"/></group><group><field name="resolved_by" readonly="1"/><field name="resolved_date" readonly="1"/><field name="compensation_amount"/><field name="rewash_order_id" readonly="1"/></group></group><field name="description"/><field name="root_cause"/><field name="resolution_notes"/></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="message_ids"/></div></form>
        </field>
    </record>
    <record id="action_laundry_issue" model="ir.actions.act_window">
        <field name="name">Issues</field>
        <field name="res_model">laundry.issue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
