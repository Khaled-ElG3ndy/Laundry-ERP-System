<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hotel_session_list" model="ir.ui.view">
        <field name="name">laundry.hotel.session.list</field>
        <field name="model">laundry.hotel.session</field>
        <field name="arch" type="xml">
            <tree string="Hotel Pickup Sessions"
                  decoration-success="state == 'delivered'"
                  decoration-warning="state == 'dispatched'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="commercial_id"/>
                <field name="session_date"/>
                <field name="driver_name"/>
                <field name="vehicle_plate"/>
                <field name="order_count" string="Orders"/>
                <field name="total_amount" string="Total (SAR)"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_hotel_session_form" model="ir.ui.view">
        <field name="name">laundry.hotel.session.form</field>
        <field name="model">laundry.hotel.session</field>
        <field name="arch" type="xml">
            <form string="Hotel Pickup Session">
                <header>
                    <button name="action_load_ready_orders"
                            string="📦 Load Ready Orders"
                            type="object" class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_dispatch"
                            string="🚗 Dispatch"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Dispatch the driver now?"/>
                    <button name="action_mark_delivered"
                            string="✓ Mark Delivered"
                            type="object" class="btn-success"
                            invisible="state != 'dispatched'"
                            confirm="Confirm the delivery to the hotel?"/>
                    <button name="action_print_manifest"
                            string="🖨 Print Manifest"
                            type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,dispatched,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Session Info">
                            <field name="commercial_id" string="Hotel"/>
                            <field name="session_date" string="Pickup Date"/>
                            <field name="branch_id" string="Branch"/>
                        </group>
                        <group string="Driver">
                            <field name="driver_name" string="Driver Name"/>
                            <field name="vehicle_plate" string="Vehicle Plate"/>
                            <field name="pickup_time" readonly="1" string="Dispatched At"/>
                            <field name="delivery_time" readonly="1" string="Delivered At"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders">
                            <field name="order_ids" widget="many2many_list">
                                <tree>
                                    <field name="name"/>
                                    <field name="partner_id" string="Customer"/>
                                    <field name="state"/>
                                    <field name="amount_total" string="Amount"/>
                                    <field name="promise_date" string="Promise Date"/>
                                    <field name="bag_reference" string="Bag"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_amount" readonly="1"
                                       string="Total" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Session notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_sessions" model="ir.actions.act_window">
        <field name="name">Hotel Sessions</field>
        <field name="res_model">laundry.hotel.session</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hotel_sessions"
              name="🏨 Hotel Pickup"
              parent="menu_laundry_operations"
              action="laundry_base.action_hotel_sessions"
              sequence="65"
              groups="laundry_base.group_laundry_manager,laundry_base.group_laundry_supervisor"/>

</odoo>
