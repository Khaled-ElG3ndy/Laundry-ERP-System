<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laundry_item_cat_list" model="ir.ui.view">
        <field name="name">laundry.item.category.list</field>
        <field name="model">laundry.item.category</field>
        <field name="arch" type="xml">
            <tree string="Item Categories" editable="top"><field name="sequence" widget="handle"/><field name="name"/><field name="name_ar"/><field name="code"/><field name="default_service_id"/><field name="active"/></tree>
        </field>
    </record>
    <record id="view_laundry_item_cat_form" model="ir.ui.view">
        <field name="name">laundry.item.category.form</field>
        <field name="model">laundry.item.category</field>
        <field name="arch" type="xml">
            <form><sheet><group><group><field name="name"/><field name="name_ar"/><field name="code"/><field name="sequence"/></group><group><field name="image" widget="image"/><field name="default_service_id"/><field name="active"/></group></group><field name="special_handling_notes"/><field name="applicable_service_ids" widget="many2many_tags"/></sheet></form>
        </field>
    </record>
    <record id="action_laundry_item_category" model="ir.actions.act_window">
        <field name="name">Item Categories / فئات الملابس</field>
        <field name="res_model">laundry.item.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
