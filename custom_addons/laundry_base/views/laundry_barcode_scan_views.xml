<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Barcode scanner = just a filtered list of production orders -->
    <!-- No custom form view needed - uses the main order form -->

    <record id="action_laundry_barcode_scanner" model="ir.actions.act_window">
        <field name="name">Barcode Scanner</field>
        <field name="res_model">laundry.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("state","in",["received","tagged","washing","ironing","packing"])]</field>
        <field name="context">{"search_default_filter_active": 1}</field>
    </record>

    <menuitem id="menu_laundry_barcode_scan"
              name="📱 Scan Barcode"
              parent="menu_laundry_operations"
              action="laundry_base.action_laundry_barcode_scanner"
              sequence="15"
              groups="laundry_base.group_laundry_production,laundry_base.group_laundry_supervisor"/>

</odoo>