<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form_pos_laundry_receipt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.laundry.receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <setting id="laundry_require_ten_digit_phone_setting"
                         string="Enable 10-Digit Phone Validation"
                         help="When enabled, customer phone and mobile numbers must contain exactly 10 digits, and the POS phone input is limited to 10 digits.">
                    <field name="laundry_require_ten_digit_phone"/>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="view_res_config_settings_form_pos_laundry_sla" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.laundry.sla</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="pos_laundry_sla_calendar_setting"
                         string="Laundry SLA Calendar"
                         help="Choose the working calendar used for laundry SLA deadlines for this POS branch. Friday is always excluded.">
                    <field name="pos_laundry_sla_calendar_id"
                           options="{'no_create_edit': False}"
                           readonly="pos_has_active_session"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
